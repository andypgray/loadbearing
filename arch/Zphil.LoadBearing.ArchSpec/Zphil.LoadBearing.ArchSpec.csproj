<Project Sdk="Microsoft.NET.Sdk">

    <!-- This repo's own architecture spec — the dogfood render source. It references Core (the reified
         model every spec builds against) plus the Roslyn host project, solely so the Quarantine rule's
         BoundaryOnlyVia(typeof(MsBuildBootstrap)) can name the facade type. The boundary is recorded by
         name and never invoked, so the extra reference is inert at check time. It also takes the
         DotNetGuidance rule pack, which is where two of its DI rules come from. Loaded by the CLI via the
         spec flag (convention resolution is ambiguous here because the test fixtures also reference Core).
         Its rendered block lives in the committed root AGENTS.md, kept current by the self-spec tests.
         IsPackable=false: it ships with nothing.

         CopyLocalLockFileAssemblies is load-bearing from the moment the pack arrives: the CLI loads this
         spec into an AssemblyLoadContext whose AssemblyDependencyResolver is rooted at the built spec
         DLL, so the pack's own package dependencies (the two Microsoft.Extensions.DependencyInjection
         assemblies) have to sit beside it. This project declares no PackageReference of its own, so
         without this they would resolve at build time and be missing at check time. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Zphil.LoadBearing\Zphil.LoadBearing.csproj" />
        <ProjectReference Include="..\..\src\Zphil.LoadBearing.Packs.DotNet\Zphil.LoadBearing.Packs.DotNet.csproj" />
        <ProjectReference Include="..\..\src\Zphil.LoadBearing.Roslyn\Zphil.LoadBearing.Roslyn.csproj" />
    </ItemGroup>

</Project>
