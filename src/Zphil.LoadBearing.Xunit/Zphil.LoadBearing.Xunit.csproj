<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- The test-adapter surface: each post-desugar rule becomes an
             individually named xUnit test whose failure text matches the CLI human block. net10.0 host
             over Core (model) + Roslyn (workspace/extraction). -->
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <!-- The xUnit adapter package. PackageId is explicit; version + shared metadata come from the
             repo-root Directory.Build.props. The &lt;TSpec&gt; in the description is XML-escaped. -->
        <PackageId>Zphil.LoadBearing.Xunit</PackageId>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Description>The LoadBearing xUnit adapter: derive a test class from ArchRuleTests&lt;TSpec&gt; and every rule in the architecture spec becomes an individually named xUnit test, with failure text identical to the loadbearing CLI. Requires xunit.v3 4.0.0 or later, which runs on Microsoft.Testing.Platform rather than VSTest, and a .NET SDK on the test host (the checker loads the target solution through MSBuildWorkspace).</Description>
        <PackageTags>architecture;architecture-as-code;xunit;testing;fitness-functions;dependency-rules;layering;csharp;dotnet</PackageTags>

        <!-- ApiCompat at pack time against the published package, strict (additions report too).
             The Core csproj carries the reasoning for all of it; this is the second of the two
             assemblies a consumer's own project compiles against, so it gets the same treatment.
             The other two packages are deliberate exemptions — .Roslyn says in its own Description
             that it is not for direct reference, and .Cli is PackAsTool — and
             PublicSurfaceSyncTests holds each exemption to that recorded reason. -->
        <EnablePackageValidation>true</EnablePackageValidation>
        <PackageValidationBaselineVersion>0.7.0</PackageValidationBaselineVersion>
        <EnableStrictModeForBaselineValidation>true</EnableStrictModeForBaselineValidation>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Zphil.LoadBearing\Zphil.LoadBearing.csproj" />
        <ProjectReference Include="..\Zphil.LoadBearing.Roslyn\Zphil.LoadBearing.Roslyn.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The library-authoring pair (extensibility + assert), not the xunit.v3 metapackage — a test
             library references these, its consumers keep the metapackage. Since 4.0.0 that is the whole
             consumer side: the runner ships inside the metapackage as Microsoft.Testing.Platform, so
             there is no separate runner package to name. -->
        <PackageReference Include="xunit.v3.extensibility.core" Version="4.0.0" />
        <PackageReference Include="xunit.v3.assert" Version="4.0.0" />
    </ItemGroup>

</Project>
