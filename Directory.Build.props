<Project>

    <!-- Repo-wide package identity, shared by all four shipping projects. The four packages
         (Zphil.LoadBearing, .Roslyn, .Xunit, .Cli) version in lockstep: this <Version> is the only
         MSBuild-side declaration. It must agree with the two copies in .mcp/server.json (.version and
         .packages[0].version); release.yml refuses a tag unless all three equal the tag.
         The nuget metadata below (authors, licence, project/repo URLs, SourceLink
         knobs, symbol packages) is identical across the four, so it lives here rather than being
         copy-pasted into each csproj. -->
    <!-- The binding identity is pinned and deliberately does NOT track <Version>. AssemblyVersion is what
         a spec project's compiled reference to Zphil.LoadBearing carries, and the default binder rejects a
         host whose copy is older than that reference — so letting it track the package version meant every
         release minted a new identity and broke specs built against a newer contract than the tool running
         them (issue #19). FileVersion and InformationalVersion still track <Version>, so "which build is
         this" stays answerable; nothing reads AssemblyVersion (ServerVersion and the SARIF driver both go
         through InformationalVersion). 1.0.0.0 is the value to pin to because it is what the SDK assigns a
         source-built or vendored contract, which puts packaged and source builds on one identity, and it
         outranks every version shipped before the pin (0.1.0.0, 0.2.0.0) so their specs still bind. -->
    <PropertyGroup>
        <Version>0.5.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <!-- FileVersion defaults to AssemblyVersion, not to Version (Microsoft.NET.GenerateAssemblyInfo
             .targets), so pinning one would silently pin both. Restated from Version, with any prerelease
             suffix trimmed because a file version must be four numeric parts. -->
        <FileVersion>$([System.Text.RegularExpressions.Regex]::Match($(Version), '^[0-9]+\.[0-9]+\.[0-9]+')).0</FileVersion>
        <Authors>Andrew Gray</Authors>
        <Copyright>Copyright (c) 2026 Andrew Gray</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/andypgray/loadbearing</PackageProjectUrl>
        <RepositoryUrl>https://github.com/andypgray/loadbearing</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <!-- Deliberately NO $(CI)-conditioned build policy here — not the lock-file policy
         (RestorePackagesWithLockFile / RestoreLockedMode) and not ContinuousIntegrationBuild. All of
         it lives one level down in src/Directory.Build.props (plus an inline lock-file copy in the
         tests csproj) instead.

         Reason, shared by both: fixture solutions are staged under a project's bin/ and built there
         mid-test-run — FixtureRestorer shells `dotnet restore` on them, and MSBuildWorkspace runs
         design-time builds over them — all without stripping $(CI) from the child process. Those
         throwaway copies sit inside the repo tree, so they walk up and import whatever props file is
         above them, and this is that file. A repo-root policy therefore reaches code it was never
         written for:

         - A lock policy would demand committed lock files for the temp fixture projects and, in CI,
           fail their locked-mode restore outright, breaking the temp-copy contract.
         - ContinuousIntegrationBuild implies DeterministicSourcePaths, which requires SourceRoot
           items. A non-SDK-style project in the 2003 MSBuild XML namespace has no SourceLink and so
           no SourceRoot, and its design-time build fails with "SourceRoot items must include at least
           one top-level (not nested) item" — a workspace-load diagnostic that reds `check` on the CI
           legs only. That is a real bug this file shipped, found 2026-08-03 (see the ClassicApp
           fixture and ClassicProjectCheckTests).

         Scoping both below the repo root keeps the shipping projects deterministic and locked while
         leaving fixtures unencumbered. -->

</Project>
